# ===============================================
# TELEGRAM BOT SOZLAMALARI (BotFather orqali olinadi)
# ===============================================
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
ADMIN_TELEGRAM_ID=123456789

# ===============================================
# TELEGRAM USERBOT (Telethon) SOZLAMALARI
# (Telefon raqam bo'yicha Telegram egasini topish va unga xabar yozish uchun)
# my.telegram.org saytidan olinadi: API development tools
# ===============================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+998901234567

# ===============================================
# INSTAGRAM HISOB SOZLAMALARI
# (Bot siz yozgan odamlarning profilini avtomatik kuzatishi uchun)
# ===============================================
INSTAGRAM_USERNAME=sizning_instagram_loginingiz
INSTAGRAM_PASSWORD=sizning_instagram_parolingiz
INSTAGRAM_CHECK_INTERVAL=30

# ===============================================
# MA'LUMOTLAR BAZASI (Supabase / PostgreSQL)
# Supabase Project Settings -> Database -> Connection string (URI)
# Masalan: postgresql+asyncpg://postgres:parol@db.xxx.supabase.co:5432/postgres
# Agar SQLite bilan sinab ko'rmoqchi bo'lsangiz: sqlite+aiosqlite:///./leads.db
# ===============================================
DATABASE_URL=postgresql+asyncpg://postgres.your_supabase_id:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ===============================================
# FASTAPI BACKEND SERVER SOZLAMALARI
# ===============================================
HOST=0.0.0.0
PORT=8000

# ===============================================
# AVTOMATIK XABAR MATNI

# Mijozga yuboriladigan andoza xabar
# ===============================================
AUTO_MESSAGE_TEMPLATE="Assalomu alaykum {name}! Siz Instagram sahifamizda so'rov qoldirgan edingiz. Sizga qanday yordam bera olamiz?"
EXCEL_FILE_PATH=leads.xlsx

